{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "author_name": {
      "type": "string",
      "title": "Nome do Autor"
    },
    "author_role": {
      "type": "string",
      "title": "Cargo / Fun\u00e7\u00e3o"
    },
    "author_company": {
      "type": "string",
      "title": "Empresa"
    },
    "text": {
      "type": "string",
      "title": "Depoimento"
    },
    "initials": {
      "type": "string",
      "title": "Iniciais (ex: JM)"
    },
    "active": {
      "type": "boolean",
      "title": "Ativo",
      "default": true
    },
    "order": {
      "type": "number",
      "title": "Ordem de exibi\u00e7\u00e3o"
    }
  },
